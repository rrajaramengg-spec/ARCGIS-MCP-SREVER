# MapGPT environment template
# Copy this file to .env and replace placeholders with your own values.
# Never commit a populated .env file.

# Application settings
APP_NAME=MapGPT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/mapgpt/v1

# LLM provider
AZURE_OPENAI_API_KEY=<your-llm-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=<your-chat-deployment>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>
EMBEDDING_DIMENSION=1536

# Local container database defaults
POSTGRES_USER=mapgpt
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=mapgpt

# Application database URL
DATABASE_URL=postgresql+asyncpg://mapgpt:<change-me>@postgres:5432/mapgpt
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Connection
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ArcGIS access
ARCGIS_PORTAL_URL=https://<your-portal-host>/arcgis
ARCGIS_USERNAME=<your-username>
ARCGIS_PASSWORD=<your-arcgis-password>
# Set to false only for local development with self-signed certificates.
ARCGIS_VERIFY_SSL=true
# Optional explicit token endpoint override.
# ARCGIS_TOKEN_URL=
# Optional ArcGIS Server base URL for federated setups.
# ARCGIS_SERVER_URL=

# MCP ArcGIS Server
ARCGIS_MCP_URL=http://mcp-arcgis-server:8001/sse
ARCGIS_MCP_HOST=0.0.0.0
ARCGIS_MCP_PORT=8001

# Web Chat UI (demo only)
MAPGPT_CLIENT_URL=http://mcp-mapgpt-client:8002

# Application security
SECRET_KEY=<generate-a-random-secret-with-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Optional fallback OpenAI key
OPENAI_API_KEY=<optional-fallback-key>

# Celery Broker (Redis)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Observability
# LOG_FORMAT: 'text' (default, human-readable) or 'json' (structured, ELK/Grafana-compatible)
LOG_FORMAT=text
# LOG_CORRELATION_ENABLED: Inject request correlation IDs into all log entries
LOG_CORRELATION_ENABLED=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mapgpt
ENABLE_TELEMETRY=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60


# Vector Search Settings
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_MIN_SCORE=0.7
HYBRID_SEARCH_ALPHA=0.5

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=txt,md,json
UPLOAD_DIR=./uploads

# Enable graph runtime for analyze actions only
GRAPH_RUNTIME_ENABLED=true
GRAPH_RUNTIME_ACTIONS=["analyze","locate","query"]
NODE_RETRY_BUDGET=2
ARCGIS_MAX_CONCURRENT=10
