# ========================================
# MCP ArcGIS Server — Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ========================================
# SENSITIVE CREDENTIALS ONLY
# ========================================
# Application Settings
APP_NAME=MCP ArcGIS Server
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Azure OpenAI API Key (Required)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint-here
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Database Password (embedded in URL)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@postgres:5432/gisdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Connection
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ArcGIS Enterprise
# ARCGIS_PORTAL_URL: Full portal URL including site path (e.g. https://host.com/arcgis)
#   Used for token generation via {ARCGIS_PORTAL_URL}/sharing/rest/generateToken
#   and hostname extraction for domain-based token matching
ARCGIS_PORTAL_URL=https://your-arcgis-portal.example.com/arcgis
ARCGIS_USERNAME=your-arcgis-username
ARCGIS_PASSWORD=your-arcgis-password
# ARCGIS_VERIFY_SSL: Set to "false" for self-signed or enterprise certificates (default: true)
ARCGIS_VERIFY_SSL=true
# ARCGIS_TOKEN_URL: (Optional) Explicit override for the generateToken endpoint URL.
#   Use when the portal's auto-discovered token URL is wrong (e.g. federated servers, proxies).
#   Example: https://host.com/server/tokens/generateToken
# ARCGIS_TOKEN_URL=
# ARCGIS_SERVER_URL: (Optional) ArcGIS Server base URL for federated setups.
#   Used to construct {ARCGIS_SERVER_URL}/tokens/generateToken when ARCGIS_TOKEN_URL is not set.
#   Example: https://host.com/server
# ARCGIS_SERVER_URL=

# MCP ArcGIS Server
ARCGIS_MCP_URL=http://mcp-arcgis-server:8001/sse
ARCGIS_MCP_HOST=0.0.0.0
ARCGIS_MCP_PORT=8001

# Web Chat UI (demo only)
GIS_CLIENT_URL=http://mcp-mapgpt-client:8000

# Security - JWT Secret Key (min 32 characters)
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Optional: Legacy OpenAI API Key (fallback)
OPENAI_API_KEY=your-openai-api-key-here

# Celery Broker (Redis)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mcp-arcgis-server
ENABLE_TELEMETRY=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60


# Vector Search Settings
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_MIN_SCORE=0.7
HYBRID_SEARCH_ALPHA=0.5

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=txt,md,json
UPLOAD_DIR=./uploads
