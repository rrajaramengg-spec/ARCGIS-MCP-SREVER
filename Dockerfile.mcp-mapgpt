FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl libkrb5-dev gcc && rm -rf /var/lib/apt/lists/*

COPY mcp-mapgpt-client/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install mcp-arcgis-server package for in-process transport
COPY mcp-arcgis-server/ /app/mcp-arcgis-server/
RUN pip install --no-cache-dir /app/mcp-arcgis-server

COPY mcp-mapgpt-client/ .

EXPOSE 8002

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
